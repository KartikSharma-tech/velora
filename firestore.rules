rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      function validPrivateProfile() {
        return request.resource.data.keys().hasOnly([
            'uid', 'name', 'email', 'photoUrl', 'about', 'isOnline', 'lastSeen',
            'createdAt', 'updatedAt', 'blockedUsers', 'phoneNumber', 'username',
            'bio', 'usernameChangeCount', 'usernameLastReset', 'discoverability',
            'whoCanMessage'
          ])
          && request.resource.data.keys().hasAll([
            'uid', 'name', 'email', 'photoUrl', 'about', 'isOnline', 'lastSeen',
            'createdAt', 'updatedAt', 'blockedUsers', 'phoneNumber',
            'discoverability', 'whoCanMessage'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && request.resource.data.photoUrl is string
          && request.resource.data.photoUrl.size() <= 2048
          && request.resource.data.about is string
          && request.resource.data.about.size() <= 500
          && request.resource.data.isOnline is bool
          && (request.resource.data.lastSeen == null
            || request.resource.data.lastSeen is timestamp)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.blockedUsers is list
          && request.resource.data.blockedUsers.size() <= 500
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.size() <= 20
          && (request.resource.data.phoneNumber == ''
            || request.resource.data.phoneNumber == request.auth.token.phone_number)
          && request.resource.data.discoverability in [
            'phone_number', 'username', 'hidden'
          ]
          && request.resource.data.whoCanMessage in [
            'anyone', 'contacts', 'contacts_and_requests', 'nobody'
          ];
      }

      allow read: if isUser(userId);
      allow create: if isUser(userId) && validPrivateProfile();

      allow update: if isUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 500
        && request.resource.data.isOnline is bool
        && (request.resource.data.lastSeen == null
          || request.resource.data.lastSeen is timestamp)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.blockedUsers is list
        && request.resource.data.blockedUsers.size() <= 500
        && (request.resource.data.phoneNumber == resource.data.phoneNumber
          || request.resource.data.phoneNumber == request.auth.token.phone_number)
        && request.resource.data.discoverability in [
          'phone_number', 'username', 'hidden'
        ]
        && request.resource.data.whoCanMessage in [
          'anyone', 'contacts', 'contacts_and_requests', 'nobody'
        ]
        && (!('username' in request.resource.data.keys())
          || request.resource.data.username == null
          || (request.resource.data.username is string
            && request.resource.data.username.size() <= 30))
        && (!('bio' in request.resource.data.keys())
          || request.resource.data.bio == null
          || (request.resource.data.bio is string
            && request.resource.data.bio.size() <= 500))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoUrl', 'about', 'isOnline', 'lastSeen', 'updatedAt',
          'username', 'bio', 'usernameChangeCount', 'usernameLastReset',
          'blockedUsers', 'discoverability', 'whoCanMessage', 'phoneNumber'
        ]);

      allow delete: if isUser(userId);

      // A user's FCM registration tokens are private to that account.
      match /devices/{deviceId} {
        // Device tokens are managed by an App Check protected server endpoint.
        allow read, write: if false;
      }
    }

    // Public user cards contain no email address or phone number.
    match /public_profiles/{userId} {
      function validPublicProfile() {
        return request.resource.data.keys().hasOnly([
            'uid', 'name', 'photoUrl', 'about', 'isOnline', 'lastSeen',
            'createdAt', 'updatedAt', 'username', 'bio', 'discoverability',
            'whoCanMessage'
          ])
          && request.resource.data.keys().hasAll([
            'uid', 'name', 'photoUrl', 'about', 'isOnline', 'lastSeen',
            'createdAt', 'updatedAt', 'discoverability', 'whoCanMessage'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.photoUrl is string
          && request.resource.data.photoUrl.size() <= 2048
          && request.resource.data.about is string
          && request.resource.data.about.size() <= 500
          && request.resource.data.isOnline is bool
          && (request.resource.data.lastSeen == null
            || request.resource.data.lastSeen is timestamp)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.discoverability in [
            'phone_number', 'username', 'hidden'
          ]
          && request.resource.data.whoCanMessage in [
            'anyone', 'contacts', 'contacts_and_requests', 'nobody'
          ]
          && (!('username' in request.resource.data.keys())
            || request.resource.data.username == null
            || (request.resource.data.username is string
              && request.resource.data.username.size() <= 30))
          && (!('bio' in request.resource.data.keys())
            || request.resource.data.bio == null
            || (request.resource.data.bio is string
              && request.resource.data.bio.size() <= 500));
      }

      function hasChatWithProfileOwner() {
        let forwardPath = /databases/$(database)/documents/chat_rooms/$(request.auth.uid + '_' + userId);
        let reversePath = /databases/$(database)/documents/chat_rooms/$(userId + '_' + request.auth.uid);
        return signedIn() && (
          (exists(forwardPath)
            && request.auth.uid in get(forwardPath).data.participants)
          || (exists(reversePath)
            && request.auth.uid in get(reversePath).data.participants)
        );
      }

      allow get: if isUser(userId)
        || (signedIn() && resource.data.discoverability in ['phone_number', 'username'])
        || hasChatWithProfileOwner();
      allow list: if signedIn()
        && resource.data.discoverability in ['phone_number', 'username'];
      allow create: if isUser(userId) && validPublicProfile();
      allow update: if isUser(userId)
        && validPublicProfile()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoUrl', 'about', 'isOnline', 'lastSeen', 'updatedAt',
          'username', 'bio', 'discoverability', 'whoCanMessage'
        ]);
      allow delete: if isUser(userId);
    }
    match /chat_rooms/{roomId} {
      function recipientHasSenderAsContact(otherUserId) {
        let contactsPath = /databases/$(database)/documents/message_contacts/$(otherUserId);
        return exists(contactsPath)
          && get(contactsPath).data.syncedAt is timestamp
          && request.time < get(contactsPath).data.syncedAt + duration.value(24, 'h')
          && get(contactsPath).data.contactUids is list
          && get(contactsPath).data.contactUids.hasAny([request.auth.uid]);
      }

      function recipientAllowsNewRoom(otherUserId) {
        let recipient = get(
          /databases/$(database)/documents/users/$(otherUserId)
        ).data;
        let requestPath = /databases/$(database)/documents/chat_requests/$(request.auth.uid + '_' + otherUserId);
        let messagePrivacy = recipient.get('whoCanMessage', 'contacts_and_requests');
        return messagePrivacy == 'anyone'
          || (messagePrivacy in ['contacts', 'contacts_and_requests']
            && recipientHasSenderAsContact(otherUserId))
          || (messagePrivacy == 'contacts_and_requests'
            && exists(requestPath)
            && get(requestPath).data.fromUserId == request.auth.uid
            && get(requestPath).data.toUserId == otherUserId
            && get(requestPath).data.status == 'accepted');
      }

      function noParticipantHasBlocked(otherUserId) {
        let ownProfile = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data;
        let otherProfile = get(
          /databases/$(database)/documents/users/$(otherUserId)
        ).data;
        return !(otherUserId in ownProfile.get('blockedUsers', []))
          && !(request.auth.uid in otherProfile.get('blockedUsers', []));
      }

      function latestMessageMatchesPreview() {
        let messagePath = /databases/$(database)/documents/chat_rooms/$(roomId)/messages/$(request.resource.data.lastMessageId);
        let latestMessage = getAfter(messagePath).data;
        return existsAfter(messagePath)
          && latestMessage.id == request.resource.data.lastMessageId
          && latestMessage.chatRoomId == roomId
          && latestMessage.senderId == request.auth.uid
          && latestMessage.timestamp == request.time
          && request.resource.data.lastMessageTime == request.time
          && request.resource.data.lastMessage == (
            latestMessage.type == 'image' && latestMessage.text == ''
              ? 'Photo'
              : latestMessage.text
          );
      }

      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/chat_rooms/$(roomId))
          || request.auth.uid in resource.data.participants);

      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'participants', 'lastMessage', 'lastMessageSenderId',
          'lastMessageId', 'lastMessageTime', 'lastMessageSeen', 'createdAt', 'pinnedBy',
          'typingUsers', 'deletedBy'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'participants', 'lastMessage', 'lastMessageSenderId',
          'lastMessageId', 'lastMessageTime', 'lastMessageSeen', 'createdAt', 'pinnedBy',
          'typingUsers', 'deletedBy'
        ])
        && request.resource.data.id == roomId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && roomId == request.resource.data.participants[0]
          + '_' + request.resource.data.participants[1]
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastMessageId == ''
        && request.resource.data.lastMessageSenderId == ''
        && request.resource.data.lastMessageSeen == true
        && request.resource.data.lastMessageTime is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.pinnedBy == []
        && request.resource.data.typingUsers == []
        && request.resource.data.deletedBy == []
        && recipientAllowsNewRoom(
          request.resource.data.participants[0] == request.auth.uid
            ? request.resource.data.participants[1]
            : request.resource.data.participants[0])
        && noParticipantHasBlocked(
          request.resource.data.participants[0] == request.auth.uid
            ? request.resource.data.participants[1]
            : request.resource.data.participants[0]);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.id == resource.data.id
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageId', 'lastMessageSenderId', 'lastMessageTime',
          'lastMessageSeen', 'pinnedBy', 'typingUsers', 'deletedBy'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'lastMessage', 'lastMessageId', 'lastMessageSenderId', 'lastMessageTime'
          ])
          || (request.resource.data.diff(resource.data).affectedKeys().hasAll([
              'lastMessage', 'lastMessageId', 'lastMessageSenderId', 'lastMessageTime'
            ])
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 5000
            && request.resource.data.lastMessageId is string
            && request.resource.data.lastMessageId.size() <= 150
            && request.resource.data.lastMessageSenderId == request.auth.uid
            && request.resource.data.lastMessageSenderId in resource.data.participants
            && request.resource.data.lastMessageTime is timestamp
            && latestMessageMatchesPreview()))
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['lastMessageSeen'])
          || (request.resource.data.lastMessageSeen == true
            && resource.data.lastMessageSenderId != request.auth.uid)
          || (request.resource.data.lastMessageSeen == false
            && request.resource.data.lastMessageSenderId == request.auth.uid))
        && request.resource.data.get('pinnedBy', []) is list
        && request.resource.data.pinnedBy.size() <= 2
        && request.resource.data.pinnedBy.toSet()
          .difference(resource.data.get('pinnedBy', []).toSet())
          .hasOnly([request.auth.uid])
        && resource.data.get('pinnedBy', []).toSet()
          .difference(request.resource.data.pinnedBy.toSet())
          .hasOnly([request.auth.uid])
        && request.resource.data.get('typingUsers', []) is list
        && request.resource.data.typingUsers.size() <= 2
        && request.resource.data.typingUsers.toSet()
          .difference(resource.data.get('typingUsers', []).toSet())
          .hasOnly([request.auth.uid])
        && resource.data.get('typingUsers', []).toSet()
          .difference(request.resource.data.typingUsers.toSet())
          .hasOnly([request.auth.uid])
        && request.resource.data.get('deletedBy', []) is list
        && request.resource.data.deletedBy.size() <= 2
        && request.resource.data.deletedBy.toSet()
          .difference(resource.data.get('deletedBy', []).toSet())
          .hasOnly([request.auth.uid])
        && resource.data.get('deletedBy', []).toSet()
          .difference(request.resource.data.deletedBy.toSet())
          .hasOnly([request.auth.uid]);

      allow delete: if false;

      match /messages/{messageId} {
        function isRoomParticipant() {
          return signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/chat_rooms/$(roomId)
            ).data.participants;
        }

        allow read: if isRoomParticipant();

        function roomParticipants() {
          return get(
            /databases/$(database)/documents/chat_rooms/$(roomId)
          ).data.participants;
        }

        function changedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        allow create: if isRoomParticipant()
          && request.resource.data.keys().hasOnly([
            'id', 'chatRoomId', 'senderId', 'receiverId', 'text', 'type',
            'timestamp', 'isSeen', 'isDelivered', 'deliveredAt', 'seenAt',
            'imageUrl', 'replyToId', 'replyToText', 'replyToSenderName',
            'deletedFor', 'isDeletedForEveryone', 'reactions'
          ])
          && request.resource.data.id == messageId
          && request.resource.data.chatRoomId == roomId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in roomParticipants()
          && request.resource.data.type in ['text', 'image']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.timestamp is timestamp
          && request.resource.data.timestamp == request.time
          && request.resource.data.isSeen == false
          && request.resource.data.isDelivered == false
          && request.resource.data.get('deletedFor', []) is list
          && request.resource.data.deletedFor.size() == 0
          && request.resource.data.get('isDeletedForEveryone', false) == false
          && request.resource.data.get('reactions', {}) is map
          && request.resource.data.reactions.size() == 0
          && getAfter(
            /databases/$(database)/documents/chat_rooms/$(roomId)
          ).data.lastMessageId == messageId
          && getAfter(
            /databases/$(database)/documents/chat_rooms/$(roomId)
          ).data.lastMessageSenderId == request.auth.uid
          && (request.resource.data.get('replyToId', null) == null
            || (request.resource.data.replyToId is string
              && request.resource.data.replyToId.size() <= 150))
          && (request.resource.data.get('replyToText', null) == null
            || (request.resource.data.replyToText is string
              && request.resource.data.replyToText.size() <= 500))
          && (request.resource.data.get('replyToSenderName', null) == null
            || (request.resource.data.replyToSenderName is string
              && request.resource.data.replyToSenderName.size() <= 80))
          && (request.resource.data.type == 'text'
            ? request.resource.data.get('imageUrl', null) == null
            : (request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() <= 2048
              && request.resource.data.imageUrl.matches(
                'https://res\\.cloudinary\\.com/wve0mvba/image/upload/.*')))
          && noParticipantHasBlocked(request.resource.data.receiverId);

        allow update: if isRoomParticipant()
          && request.resource.data.id == resource.data.id
          && request.resource.data.chatRoomId == roomId
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && (
            // Only the recipient may advance delivery and read receipts.
            (request.auth.uid == resource.data.receiverId
              && changedKeys().hasOnly([
                'isDelivered', 'deliveredAt', 'isSeen', 'seenAt'
              ])
              && (!changedKeys().hasAny(['isDelivered'])
                || request.resource.data.isDelivered == true)
              && (!changedKeys().hasAny(['deliveredAt'])
                || (request.resource.data.isDelivered == true
                  && request.resource.data.deliveredAt is timestamp))
              && (!changedKeys().hasAny(['isSeen', 'seenAt'])
                || (request.resource.data.isSeen == true
                  && request.resource.data.seenAt is timestamp)))
            // Each participant may hide a message for themselves only.
            || (changedKeys().hasOnly(['deletedFor'])
              && request.resource.data.get('deletedFor', []) is list
              && resource.data.get('deletedFor', []) is list
              && request.resource.data.deletedFor.hasAll(resource.data.get('deletedFor', []))
              && request.resource.data.get('deletedFor', []).toSet()
                .difference(resource.data.get('deletedFor', []).toSet())
                .hasOnly([request.auth.uid]))
            // A participant may change only their own reaction.
            || (changedKeys().hasOnly(['reactions'])
              && request.resource.data.get('reactions', {}) is map
              && request.resource.data.reactions.size() <= 2
              && resource.data.get('reactions', {}) is map
              && request.resource.data.reactions.diff(resource.data.get('reactions', {}))
                .affectedKeys().hasOnly([request.auth.uid])
              && (!(request.auth.uid in request.resource.data.reactions.keys())
                || (request.resource.data.reactions[request.auth.uid] is string
                  && request.resource.data.reactions[request.auth.uid].size() <= 8)))
            // Only the original sender may delete the message for everyone.
            || (request.auth.uid == resource.data.senderId
              && resource.data.get('isDeletedForEveryone', false) == false
              && changedKeys().hasOnly([
                'isDeletedForEveryone', 'text', 'imageUrl', 'reactions'
              ])
              && request.resource.data.isDeletedForEveryone == true
              && request.resource.data.text == ''
              && request.resource.data.imageUrl == null
              && request.resource.data.get('reactions', {}) is map
              && request.resource.data.reactions.size() == 0)
          );

        allow delete: if false;
      }
    }

    // Contact indexes are written only by the trusted contact lookup function.
    match /message_contacts/{userId} {
      allow read, write: if false;
    }

    match /chat_requests/{requestId} {
      function validRequestDocument() {
        return request.resource.data.keys().hasOnly([
            'id', 'fromUserId', 'fromUserName', 'fromUserPhoto', 'toUserId',
            'toUserName', 'toUserPhoto', 'message', 'status', 'createdAt',
            'respondedAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'fromUserId', 'fromUserName', 'fromUserPhoto', 'toUserId',
            'toUserName', 'toUserPhoto', 'message', 'status', 'createdAt',
            'respondedAt'
          ])
          && request.resource.data.id == requestId
          && request.resource.data.fromUserId is string
          && request.resource.data.fromUserName is string
          && request.resource.data.fromUserName.size() <= 80
          && request.resource.data.fromUserPhoto is string
          && request.resource.data.fromUserPhoto.size() <= 2048
          && request.resource.data.toUserId is string
          && request.resource.data.toUserName is string
          && request.resource.data.toUserName.size() <= 80
          && request.resource.data.toUserPhoto is string
          && request.resource.data.toUserPhoto.size() <= 2048
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 300
          && request.resource.data.status in ['pending', 'accepted', 'declined']
          && request.resource.data.createdAt is timestamp
          && (request.resource.data.respondedAt == null
            || request.resource.data.respondedAt is timestamp);
      }

      function requestNamesMatchProfiles() {
        let sender = get(
          /databases/$(database)/documents/public_profiles/$(request.resource.data.fromUserId)
        ).data;
        let recipient = get(
          /databases/$(database)/documents/public_profiles/$(request.resource.data.toUserId)
        ).data;
        return request.resource.data.fromUserName == sender.name
          && request.resource.data.fromUserPhoto == sender.photoUrl
          && request.resource.data.toUserName == recipient.name
          && request.resource.data.toUserPhoto == recipient.photoUrl;
      }

      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);

      allow create: if signedIn()
        && validRequestDocument()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUserId
        && requestNamesMatchProfiles()
        && request.resource.data.status == 'pending'
        && request.resource.data.respondedAt == null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('blockedUsers', []).hasAny([request.resource.data.toUserId]) == false
        && get(/databases/$(database)/documents/users/$(request.resource.data.toUserId))
          .data.get('blockedUsers', []).hasAny([request.auth.uid]) == false
        && get(/databases/$(database)/documents/users/$(request.resource.data.toUserId))
          .data.get('whoCanMessage', 'contacts_and_requests') == 'contacts_and_requests';

      allow update: if signedIn()
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && (
          (resource.data.toUserId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'respondedAt'
            ])
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.respondedAt is timestamp)
          || (resource.data.fromUserId == request.auth.uid
            && resource.data.status == 'declined'
            && validRequestDocument()
            && request.resource.data.status == 'pending'
            && request.resource.data.respondedAt == null
            && request.resource.data.createdAt is timestamp
            && requestId == request.auth.uid + '_' + request.resource.data.toUserId
            && request.resource.data.toUserId == resource.data.toUserId
            && requestNamesMatchProfiles()
            && get(/databases/$(database)/documents/users/$(request.resource.data.toUserId))
              .data.get('blockedUsers', []).hasAny([request.auth.uid]) == false
            && get(/databases/$(database)/documents/users/$(request.resource.data.toUserId))
              .data.get('whoCanMessage', 'contacts_and_requests') == 'contacts_and_requests')
        );

      allow delete: if false;
    }
  }
}
